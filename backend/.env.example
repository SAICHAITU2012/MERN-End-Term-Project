# ---- Required ----
MONGO_URI=mongodb://127.0.0.1:27017/medmate
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173

# ---- Optional ----
PORT=5000
NODE_ENV=development

# Escalation: minutes after a scheduled dose before caregivers are alerted (default 60)
ESCALATION_AFTER_MIN=60

# Email alerts (optional — in-app + browser notifications work without SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MedMate <no-reply@medmate.app>"

# Cloudinary (optional — avatars fall back to server disk storage if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
